{% extends 'base.html.twig' %}
{% block title %}Bibliotheque n°{{ bibliotheque.id }}{% endblock %}

{% block body %}
    <h1>Bibliotheque</h1>

       {% dump bibliotheque %}

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ bibliotheque.id }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ bibliotheque.nom }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ bibliotheque.description }}</td>
            </tr>
            <tr>
                <th>Membre</th>
                <td>{{ bibliotheque.membre.useridentifier }}</td>
            </tr>
            <tr>
            	<th>Jeux</th>
            	<td>
            	<ul>
				{% for jeu in bibliotheque.jeux %}
				<li>
				<a href="{{  path('app_jeu_show', {'id': jeu.id }) }} {{ jeu }}</a>
				</li>
				{% endfor %}
				</ul>            	
            	</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_membre_show', {'id' : bibliotheque.membre.id}) }}"> Back to {{ bibliotheque.membre.useridentifier}} </a>

{% endblock %} {# body #} 

