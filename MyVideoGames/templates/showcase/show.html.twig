{% extends 'base.html.twig' %}

{% block title %}Showcase{% endblock %}

{% block body %}
    <h1>Showcase</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ showcase.id }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ showcase.description }}</td>
            </tr>
            <tr>
                <th>Publiee</th>
                <td>{{ showcase.publiee ? 'Yes' : 'No' }}</td>
            </tr>
            <tr>
    			<th>Jeux</th>
    				<td>
        				<ul>
                          {% for jeu in showcase.jeux %}
          					<li>
                            {{ jeu }}
          					</li>
                          {% endfor %}
        				</ul>
    				</td>
			</tr>
        </tbody>
    </table>

    <a href="{{ path('app_showcase_index') }}">back to list</a>

    <a href="{{ path('app_showcase_edit', {'id': showcase.id}) }}">edit</a>

    {{ include('showcase/_delete_form.html.twig') }}
{% endblock %}
